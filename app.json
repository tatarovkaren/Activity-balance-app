{
  "expo": {
    "name": "Activity Balance",
    "slug": "balans",
    "version": "0.31.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080B10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Activity Balance — баланс энергии",
      "shortName": "A·Balance",
      "description": "Activity Balance — ваш персональный дашборд баланса энергии: тренировки, повседневная активность, питание и вес в одном визуале.",
      "lang": "ru",
      "themeColor": "#080B10",
      "backgroundColor": "#080B10",
      "display": "standalone",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": ""
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Нужен доступ к фото, чтобы оценить порцию.",
          "cameraPermission": "Нужна камера, чтобы сфотографировать блюдо рядом с рукой."
        }
      ]
    ]
  }
}
