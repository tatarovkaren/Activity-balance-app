# Сервер пилота (Supabase, Франкфурт, тестовые данные). Оба значения публичные: адрес проекта и
# publishable key (sb_publishable_…) видны любому, кто откроет сайт; данные защищают правила доступа
# в базе (supabase/setup.sql). Секретные ключи (sb_secret_…, service_role) и пароль базы сюда НЕ класть.
# Переменная называется ANON_KEY по старому имени ключа; publishable key — его замена.
# Свои значения для локального запуска — в .env.local (перекрывает этот файл, в git не попадает).
EXPO_PUBLIC_SUPABASE_URL=https://zhrerdjqmjvdkqtkfend.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_GWRUExs28DS8N8besKBfYg_cHxw05ba
